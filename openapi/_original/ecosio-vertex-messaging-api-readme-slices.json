 {
  "page": "https://connect.ecosio.com/reference/getmessage.md",
  "definition": {
   "components": {
    "schemas": {
     "Error": {
      "description": "Details of errors.",
      "properties": {
       "code": {
        "description": "Error code returned.",
        "example": "ValidationError",
        "type": "string"
       },
       "details": {
        "description": "Array of specific errors that occurred.",
        "items": {
         "$ref": "#/components/schemas/ErrorDetail"
        },
        "type": "array"
       },
       "message": {
        "description": "Details about the error.",
        "example": "/:Invoice[1]/cac:AccountingCustomerParty[1]/cac:Party[1]/cbc:EndpointID[1], [BR-CL-25]-Endpoint identifier scheme identifier MUST belong to the CEF EAS code list",
        "type": "string"
       },
       "target": {
        "description": "Source where the error occurred.",
        "example": "Validation",
        "type": "string"
       }
      },
      "required": [
       "code",
       "message"
      ],
      "type": "object"
     },
     "ErrorDetail": {
      "properties": {
       "code": {
        "description": "Error code returned.",
        "example": "ValidationError",
        "type": "string"
       },
       "message": {
        "description": "Details about the error.",
        "example": "/:Invoice[1]/cac:AccountingCustomerParty[1]/cac:Party[1]/cbc:EndpointID[1], [BR-CL-25]-Endpoint identifier scheme identifier MUST belong to the CEF EAS code list",
        "type": "string"
       }
      },
      "required": [
       "code",
       "message"
      ],
      "type": "object"
     },
     "ErrorResponse": {
      "description": "Details of an error.",
      "properties": {
       "error": {
        "$ref": "#/components/schemas/Error",
        "description": "Details of the error."
       }
      },
      "required": [
       "error"
      ],
      "type": "object"
     },
     "HistoryEntry": {
      "description": "Historical record of the message.",
      "properties": {
       "message": {
        "description": "Message body at the time the historical record was created.",
        "example": "Successful processing confirmed by https://api.anaf.ro/prod/FCTEL.",
        "type": "string"
       },
       "status": {
        "$ref": "#/components/schemas/StatusEnum",
        "description": "Status at the time the historical record was created.",
        "enum": [
         "HANDLED",
         "TRANSMITTED",
         "ERROR",
         "TRANSIENT_ERROR",
         "RETAINED",
         "PROCESSING"
        ],
        "example": "PROCESSING"
       },
       "timestamp": {
        "description": "Timestamp of the historical record, specified in ISO 8601 format.",
        "example": "2025-06-26T18:41:46Z",
        "format": "date-time",
        "type": "string"
       }
      },
      "required": [
       "message",
       "status",
       "timestamp"
      ],
      "type": "object"
     },
     "MessageDetailsResponse": {
      "description": "Details of a message.",
      "properties": {
       "acknowledgment": {
        "description": "Confirmation of the message, specified in Base64 format.",
        "example": "",
        "format": "byte",
        "type": "string"
       },
       "error": {
        "$ref": "#/components/schemas/Error",
        "description": "Details of an error if one occurred."
       },
       "externalReferences": {
        "additionalProperties": {
         "type": "string"
        },
        "description": "Reference of an external party, such as a government.",
        "example": {
         "RO_ID_INCARCARE": "4371452761"
        },
        "type": "object"
       },
       "history": {
        "description": "Status history of the message.",
        "items": {
         "$ref": "#/components/schemas/HistoryEntry"
        },
        "type": "array"
       },
       "messageInfo": {
        "$ref": "#/components/schemas/MessageInfo"
       }
      },
      "required": [
       "acknowledgment",
       "externalReferences",
       "history",
       "messageInfo"
      ],
      "type": "object"
     },
     "MessageInfo": {
      "description": "Metadata for a message.",
      "properties": {
       "charset": {
        "description": "Encoding of the message.",
        "example": "UTF-8",
        "type": "string"
       },
       "documentTypeId": {
        "description": "Internal ID of the identified document type of the message.",
        "example": "XML_4p1_ebInterface",
        "type": "string"
       },
       "fileName": {
        "description": "Filename of the message.",
        "example": "70d4ec9d-33f9-46c1-94fc-93548dad7612.xml",
        "type": "string"
       },
       "lastChanged": {
        "description": "Timestamp of the message's last update, specified in ISO 8601 format.",
        "example": "2025-09-22T14:26Z",
        "format": "date-time",
        "type": "string"
       },
       "messageId": {
        "description": "ID of the message.",
        "example": "70d4ec9d-33f9-46c1-94fc-93548dad7612",
        "format": "uuid",
        "type": "string"
       },
       "messageSize": {
        "description": "Size of the message, specified in bytes.",
        "example": 1212341,
        "format": "int32",
        "type": "integer"
       },
       "mimeType": {
        "description": "Identified document type of the message.",
        "example": "XML",
        "type": "string"
       },
       "receivedAt": {
        "description": "Timestamp of the message's receipt, specified in ISO 8601 format.",
        "example": "2025-09-22T14:25:03Z",
        "format": "date-time",
        "type": "string"
       },
       "receiverName": {
        "description": "Name of the recipient.",
        "example": "Test Receiver",
        "type": "string"
       },
       "receiverUuid": {
        "description": "ID of the recipient.",
        "example": "4ac1e432-f900-424f-92ab-edd501812342",
        "format": "uuid",
        "type": "string"
       },
       "reference": {
        "description": "Reference ID found within the message body.",
        "example": 4711,
        "type": "string"
       },
       "senderName": {
        "description": "Name of the sender.",
        "example": "Test Sender",
        "type": "string"
       },
       "senderUuid": {
        "description": "ID of the sender.",
        "example": "45c2dae5-4235-45b0-98c2-c2342b10919f",
        "format": "uuid",
        "type": "string"
       },
       "status": {
        "$ref": "#/components/schemas/StatusEnum",
        "description": "Status of the message.",
        "enum": [
         "HANDLED",
         "TRANSMITTED",
         "ERROR",
         "TRANSIENT_ERROR",
         "RETAINED",
         "PROCESSING"
        ],
        "example": "PROCESSING"
       }
      },
      "required": [
       "charset",
       "documentTypeId",
       "fileName",
       "lastChanged",
       "messageId",
       "messageSize",
       "mimeType",
       "receivedAt",
       "receiverName",
       "receiverUuid",
       "reference",
       "senderName",
       "senderUuid",
       "status"
      ],
      "type": "object"
     },
     "MessageRawResponse": {
      "description": "Message content and details",
      "properties": {
       "message": {
        "description": "Message content, specified in Base64 format.",
        "example": "VGhpcyBpcyBhIHRlc3Q=",
        "format": "byte",
        "type": "string"
       },
       "messageInfo": {
        "$ref": "#/components/schemas/MessageInfo"
       }
      },
      "required": [
       "message",
       "messageInfo"
      ],
      "type": "object"
     },
     "MessageView": {
      "description": "Details or status of a message.",
      "enum": [
       "details",
       "status"
      ],
      "example": "status",
      "type": "string"
     },
     "StatusEnum": {
      "description": "Status of a message.",
      "enum": [
       "HANDLED",
       "TRANSMITTED",
       "ERROR",
       "TRANSIENT_ERROR",
       "RETAINED",
       "PROCESSING"
      ],
      "type": "string"
     },
     "StatusResponse": {
      "description": "Status of a message.",
      "properties": {
       "error": {
        "$ref": "#/components/schemas/Error",
        "description": "Details of an error if one occurred."
       },
       "lastChanged": {
        "description": "Timestamp of the message's last update, specified in ISO 8601 format.",
        "example": "2025-05-22T14:26Z",
        "format": "date-time",
        "type": "string"
       },
       "messageId": {
        "description": "ID of the message.",
        "example": "70d4ec9d-33f9-46c1-94fc-93548dad7612",
        "format": "uuid",
        "type": "string"
       },
       "receivedAt": {
        "description": "Timestamp of the message's receipt, specified in ISO 8601 format.",
        "example": "2025-05-22T14:26Z",
        "format": "date-time",
        "type": "string"
       },
       "status": {
        "$ref": "#/components/schemas/StatusEnum",
        "description": "Status of the message.",
        "enum": [
         "HANDLED",
         "TRANSMITTED",
         "ERROR",
         "TRANSIENT_ERROR",
         "RETAINED",
         "PROCESSING"
        ],
        "example": "PROCESSING"
       }
      },
      "required": [
       "lastChanged",
       "messageId",
       "receivedAt",
       "status"
      ],
      "type": "object"
     }
    },
    "securitySchemes": {
     "oauth2_client_credentials_flow": {
      "flows": {
       "clientCredentials": {
        "scopes": {},
        "tokenUrl": "https://dev-auth.vtxdev.net/oauth/token"
       }
      },
      "type": "oauth2"
     }
    }
   },
   "info": {
    "description": "API for managing and exchanging messages on the Vertex e-invoicing platform.",
    "title": "Vertex messaging API",
    "version": "1.0.0"
   },
   "openapi": "3.1.0",
   "paths": {
    "/api/v1/messages/{messageId}": {
     "get": {
      "description": "Retrieves a message's body, status, or detailed metadata.",
      "operationId": "getMessage",
      "parameters": [
       {
        "description": "ID of the message",
        "in": "path",
        "name": "messageId",
        "required": true,
        "schema": {
         "format": "uuid",
         "type": "string"
        }
       },
       {
        "description": "Details of the message to be returned. `status` returns the message's status. `details` returns all available metadata, external references, and acknowledgements for the message. If omitted, the message body is returned in Base64 format.",
        "example": "details",
        "in": "query",
        "name": "view",
        "required": false,
        "schema": {
         "$ref": "#/components/schemas/MessageView"
        }
       }
      ],
      "responses": {
       "200": {
        "content": {
         "application/json": {
          "schema": {
           "oneOf": [
            {
             "$ref": "#/components/schemas/MessageRawResponse"
            },
            {
             "$ref": "#/components/schemas/StatusResponse"
            },
            {
             "$ref": "#/components/schemas/MessageDetailsResponse"
            }
           ]
          }
         }
        },
        "description": "OK"
       },
       "400": {
        "content": {
         "application/json": {
          "schema": {
           "$ref": "#/components/schemas/ErrorResponse"
          }
         }
        },
        "description": "Bad Request"
       },
       "401": {
        "content": {
         "application/json": {
          "schema": {
           "$ref": "#/components/schemas/ErrorResponse"
          }
         }
        },
        "description": "Unauthorized"
       },
       "403": {
        "content": {
         "application/json": {
          "schema": {
           "$ref": "#/components/schemas/ErrorResponse"
          }
         }
        },
        "description": "Forbidden"
       },
       "404": {
        "content": {
         "application/json": {
          "schema": {
           "$ref": "#/components/schemas/ErrorResponse"
          }
         }
        },
        "description": "Not Found"
       },
       "429": {
        "content": {
         "application/json": {
          "schema": {
           "$ref": "#/components/schemas/ErrorResponse"
          }
         }
        },
        "description": "Too Many Requests. This endpoint is limited to 50 retrievals per message."
       },
       "500": {
        "content": {
         "application/json": {
