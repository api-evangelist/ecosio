   "paths": {
    "/api/v1/messages/{messageId}/documents": {
     "get": {
      "description": "Retrieves a ZIP file containing the message's original invoice and confirmation of receipt. Contents may vary by country. The response returns the ZIP file only after all necessary processing is complete, which means internal processing for inbound messages and official tax authority acknowledgement for outbound messages.",
      "operationId": "getDocuments",
      "parameters": [
       {
        "description": "ID of the message.",
        "in": "path",
        "name": "messageId",
        "required": true,
        "schema": {
         "format": "uuid",
         "type": "string"
        }
       }
      ],
      "responses": {
       "200": {
        "content": {
         "application/zip": {
          "schema": {
           "format": "binary",
           "type": "string"
          }
         }
        },
        "description": "OK"
       },
       "202": {
        "description": "Accepted"
       },
       "400": {
        "content": {
