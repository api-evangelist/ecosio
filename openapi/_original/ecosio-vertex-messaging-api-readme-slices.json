[
 {
  "page": "https://connect.ecosio.com/reference/confirm.md",
  "definition": {
   "components": {
    "schemas": {
     "ConfirmRequest": {
      "description": "Status of message processing.",
      "properties": {
       "index": {
        "additionalProperties": {},
        "description": "Index of the message as a key/value pair, such as invoice numbers. Supports multiple pairs and array values per key. The keys and values are included in the full-text search in monitor, allowing messages to be located by any of these terms.",
        "example": "{'IDOC in ERP System':'0000000962707731', 'ECB GUID':'369781112B0A1FE09DF22983AE7292D9'}",
        "type": "object"
       },
       "result": {
        "description": "If true, indicates the message processing was successful.",
        "example": true,
        "type": "boolean"
       },
       "text": {
        "description": "Additional information about message processing.",
        "example": "Sales order created",
        "type": "string"
       }
      },
      "required": [
       "result"
      ],
      "type": "object"
     },
     "Error": {
      "description": "Details of errors.",
      "properties": {
       "code": {
        "description": "Error code returned.",
        "example": "ValidationError",
        "type": "string"
       },
       "details": {
        "description": "Array of specific errors that occurred.",
        "items": {
         "$ref": "#/components/schemas/ErrorDetail"
        },
        "type": "array"
       },
       "message": {
        "description": "Details about the error.",
        "example": "/:Invoice[1]/cac:AccountingCustomerParty[1]/cac:Party[1]/cbc:EndpointID[1], [BR-CL-25]-Endpoint identifier scheme identifier MUST belong to the CEF EAS code list",
        "type": "string"
       },
       "target": {
        "description": "Source where the error occurred.",
        "example": "Validation",
        "type": "string"
       }
      },
      "required": [
       "code",
       "message"
      ],
      "type": "object"
     },
     "ErrorDetail": {
      "properties": {
       "code": {
        "description": "Error code returned.",
        "example": "ValidationError",
        "type": "string"
       },
       "message": {
        "description": "Details about the error.",
        "example": "/:Invoice[1]/cac:AccountingCustomerParty[1]/cac:Party[1]/cbc:EndpointID[1], [BR-CL-25]-Endpoint identifier scheme identifier MUST belong to the CEF EAS code list",
        "type": "string"
       }
      },
      "required": [
       "code",
       "message"
      ],
      "type": "object"
     },
     "ErrorResponse": {
      "description": "Details of an error.",
      "properties": {
       "error": {
        "$ref": "#/components/schemas/Error",
        "description": "Details of the error."
       }
      },
      "required": [
       "error"
      ],
      "type": "object"
     }
    },
    "securitySchemes": {
     "oauth2_client_credentials_flow": {
      "flows": {
       "clientCredentials": {
        "scopes": {},
        "tokenUrl": "https://dev-auth.vtxdev.net/oauth/token"
       }
      },
      "type": "oauth2"
     }
    }
   },
   "info": {
    "description": "API for managing and exchanging messages on the Vertex e-invoicing platform.",
    "title": "Vertex messaging API",
    "version": "1.0.0"
   },
   "openapi": "3.1.0",
   "paths": {
    "/api/v1/messages/{messageId}/confirm": {
     "post": {
      "description": "Confirms successful or unsuccessful processing of a message by updating the status. A successful response indicates the status was successfully updated.",
      "operationId": "confirm",
      "parameters": [
       {
        "description": "ID of the message to confirm.",
        "in": "path",
        "name": "messageId",
        "required": true,
        "schema": {
         "format": "uuid",
         "type": "string"
        }
       }
      ],
      "requestBody": {
       "content": {
        "application/json": {
         "schema": {
          "$ref": "#/components/schemas/ConfirmRequest"
         }
        }
       },
       "required": true
      },
      "responses": {
       "204": {
        "description": "No Content"
       },
       "400": {
        "content": {
         "application/json": {
          "schema": {
           "$ref": "#/components/schemas/ErrorResponse"
          }
         }
        },
        "description": "Bad Request"
       },
       "401": {
        "content": {
         "application/json": {
          "schema": {
           "$ref": "#/components/schemas/ErrorResponse"
          }
         }
        },
        "description": "Unauthorized"
       },
       "403": {
        "content": {
         "application/json": {
          "schema": {
           "$ref": "#/components/schemas/ErrorResponse"
          }
         }
        },
        "description": "Forbidden"
       },
       "404": {
        "content": {
         "application/json": {
          "schema": {
           "$ref": "#/components/schemas/ErrorResponse"
          }
         }
        },
        "description": "Not Found"
       },
       "409": {
        "content": {
         "application/json": {
          "schema": {
           "$ref": "#/components/schemas/ErrorResponse"
          }
         }
        },
        "description": "Conflict"
       },
       "413": {
        "content": {
         "application/json": {
          "schema": {
           "$ref": "#/components/schemas/ErrorResponse"
          }
         }
        },
        "description": "Content Too Large"
       },
       "429": {
        "content": {
         "application/json": {
          "schema": {
           "$ref": "#/components/schemas/ErrorResponse"
          }
         }
        },
        "description": "Too Many Requests. This endpoint is limited to 50 confirmations per message."
       },
       "500": {
        "content": {
         "application/json": {
          "schema": {
           "$ref": "#/components/schemas/ErrorResponse"
          }
         }
        },
        "description": "Internal Server Error"
       },
       "503": {
        "content": {
         "*/*": {
          "schema": {
           "$ref": "#/components/schemas/ErrorResponse"
          }
         }
        },
        "description": "Service Unavailable"
       }
      },
      "security": [
       {
        "oauth2_client_credentials_flow": []
       }
      ],
      "summary": "Confirm processing of a message",
      "tags": [
       "message-controller"
      ]
     }
    }
   },
   "servers": [
    {
     "description": "QA instance of the Vertex Messaging API",
     "url": "https://e-invoicing-message-qa.platdev.vtxdev.net"
    }
   ]
  }
 },
